# Brenqo — copy to .env.local. Everything is optional: without keys the app
# runs as a fully clickable demo (data in the browser, simulated integrations).

# Public URL of the app (used for payment webhooks and links in e-mails)
APP_URL=https://app.brenqo.nl

# OCR / AI document reading (receipts & purchase invoices) — Claude vision
ANTHROPIC_API_KEY=

# E-mail (Resend). EMAIL_FROM must be on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=facturen@brenqo.nl

# Online payments (Mollie). Use a test_ key during development.
MOLLIE_API_KEY=

# Database & storage (Supabase). Service role is server-only: webhooks and inbound mail.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Inbound e-mail webhook basic-auth secret (Postmark inbound)
INBOUND_SECRET=

# PSD2 / Open Banking aggregator (e.g. GoCardless Bank Account Data, Tink, Yapily)
BANK_PROVIDER_SECRET_ID=
BANK_PROVIDER_SECRET_KEY=
