# Brenqo — environment variables.
# Locally: copy to .env.local. On Vercel: Project → Settings → Environment Variables.
# Everything is optional: without Supabase the app runs as a clickable demo.

# ── App ─────────────────────────────────────────────────────────────
APP_URL=https://app.brenqo.nl                 # public address (links in e-mails, Mollie, bank)
NEXT_PUBLIC_INBOX_DOMAIN=inbox.brenqo.nl      # domain of the per-administration inbox addresses

# ── Supabase (database, login, files) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=         # public by design; row level security protects the data
SUPABASE_SERVICE_ROLE_KEY=                    # SECRET, server only (webhooks, cron, inbound mail)

# ── Reading receipts and invoices (Claude vision) ───────────────────
ANTHROPIC_API_KEY=

# ── E-mail (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=facturen@brenqo.nl                 # on a domain verified in Resend

# ── Online payments (Mollie) ────────────────────────────────────────
# Each administration enters its own key in Instellingen → Betalingen.
# This one is only a fallback for administrations without their own key.
MOLLIE_API_KEY=

# ── Daily job (reminders, recurring invoices, bank) ─────────────────
CRON_SECRET=                                  # Vercel Cron sends this automatically

# ── Inbound e-mail (Postmark inbound webhook, basic auth user "brenqo") ──
INBOUND_SECRET=

# ── Push notifications (generate: npx web-push generate-vapid-keys) ─
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=hallo@brenqo.nl

# ── Bank connection (GoCardless Bank Account Data, PSD2) ────────────
BANK_PROVIDER_SECRET_ID=
BANK_PROVIDER_SECRET_KEY=
